<h1>Books</h1>

<table>
  <thead>
    <tr>
      <th>Title</th>
      <th>Body</th>
      <th colspan="3"></th>
    </tr>
  </thead>
  <tbody>
    <% @bookers.order(:id).each do |booker| %>
      <tr>
        <td><%= booker.title %></td>
        <td><%= booker.content %></td>
        <td><%= link_to "show", booker_path(booker) %></td>
        <td><%= link_to "edit", edit_booker_path(booker) %></td>
        <td><%= link_to "destroy", booker_path(booker), data: { turbo_method: :delete, turbo_confirm: "Are you sure?" } %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<h2>New book</h2>
<%= form_with model: @booker do |f| %>
  <% if @booker.errors.any? %>
    <div style="color: red;">
      <h4><%= pluralize(@booker.errors.count, "error") %> prohibited this book from being saved:</h4>
      <ul>
        <% @booker.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :title, "Title" %>
    <%= f.text_field :title %>
  </div>
  <div>
    <%= f.label :content, "Body" %>
    <%= f.text_area :content %>
  </div>
  <%= f.submit "Create Book" %>
<% end %>