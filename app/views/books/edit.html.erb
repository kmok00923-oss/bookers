<h1>Editing Book</h1>
<%= form_with model: @book do |f| %>
  <% if @book.errors.any? %>
    <div style="color: red;">
      <h4><%= pluralize(@book.errors.count, "error") %> prohibited this book from being saved:</h4>
      <ul>
        <% @book.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>
  <div>
    <%= f.label :title, "Title" %>
    <%= f.text_field :title %>
  </div>
  <div>
    <%= f.label :body, "Body" %>
    <%= f.text_area :body %>
  </div>
  <%= f.submit "Update Book" %>
<% end %>
<%= link_to "Show", book_path(@book) %> |
<%= link_to "Back", books_path %>